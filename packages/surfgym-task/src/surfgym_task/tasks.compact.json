  {
    "task_id": "prozilla_setting_01",
    "instruction": "I want to change the overall look of my system. Go to the appearance settings and switch the system theme to \"Mango\"",
    "website": "http://localhost:3100",
    "states": [
      { "app": "settings" },
      { "app": "settings", "property": ["selectedTab"], "value": "1", "match": "exact" },
      { "app": "settings", "property": ["pageKey"], "value": "theme", "match": "exact" },
      { "app": "filetree", "param": "~/.config", "property": ["files", "theme.xml", "content"], "value": "<options>\n\t<theme>3</theme>\n</options>", "match": "contains" }
    ]
  },
  {
    "task_id": "prozilla_setting_02",
    "instruction": "Pin the \"Wordle\" application to the taskbar.",
    "website": "http://localhost:3100",
    "states": [
      { "app": "settings" },
      { "app": "settings", "property": ["pageKey"], "value": "installedApps", "match": "exact" },
      { "app": "taskbar", "property": ["pinned", "wordle", "id"], "value": "wordle", "match": "exact" }
    ]
  },
  {
    "task_id": "prozilla_setting_03",
    "instruction": "Please unpin the \"Terminal\" application from the taskbar.",
    "website": "http://localhost:3100",
    "states": [
      { "app": "settings" },
      { "app": "settings", "property": ["pageKey"], "value": "installedApps", "match": "exact" },
      { "app": "taskbar", "property": ["unpinned", "terminal", "id"], "value": "terminal", "match": "exact" }
    ]
  },
  {
    "task_id": "prozilla_setting_04",
    "instruction": "I want to hide all my desktop icons. There is a option called \"show icons\" in the system setting. Please disable it.",
    "website": "http://localhost:3100",
    "states": [
      { "app": "settings" },
      { "app": "settings", "property": ["selectedTab"], "value": "1", "match": "exact" },
      { "app": "settings", "property": ["pageKey"], "value": "desktop", "match": "exact" },
      { "app": "filetree", "param": "~/.config", "property": ["files", "desktop.xml", "content"], "value": "<show-icons>false</show-icons>", "match": "contains" }
    ]
  },
  {
    "task_id": "prozilla_setting_05",
    "instruction": "Please update my desktop wallpaper in the setting. I want to use the last option. Its a red colored wallpaper.",
    "website": "http://localhost:3100",
    "states": [
      { "app": "settings" },
      { "app": "settings", "property": ["selectedTab"], "value": "1", "match": "exact" },
      { "app": "settings", "property": ["pageKey"], "value": "wallpaper", "match": "exact" },
      { "app": "filetree", "param": "~/.config", "property": ["files", "desktop.xml", "content"], "value": "abstract-wallpaper-gradient-red", "match": "contains" }
    ]
  },
  {
    "task_id": "prozilla_file_edit_01",
    "instruction": "Modify 'helloworld.sh'. Make it print 'Hello, goonco!' instead of 'Hello, world!'. Please do this task using GUI so I can supervise the process",
    "website": "http://localhost:3100",
    "states": [
      { "app": "file-explorer" },
      { "app": "file-explorer", "property": ["currentPath"], "value": "~/Scripts", "match": "exact" },
      { "app": "text-editor", "property": ["currentPath"], "value": "~/Scripts/helloworld.sh", "match": "exact" },
      { "app": "filetree", "param": "~/Scripts", "property": ["files", "helloworld.sh", "content"], "value": "Hello, Goonco", "match": "contains" }
    ]
  },
  {
    "task_id": "prozilla_file_edit_02",
    "instruction": "Open text.txt under the Documents directory. Clear the file and write \"Goonco\" in it. Don't forget to save it!",
    "website": "http://localhost:3100",
    "states": [
      { "app": "file-explorer" },
      { "app": "file-explorer", "property": ["currentPath"], "value": "~/Documents", "match": "exact" },
      { "app": "text-editor", "property": ["currentPath"], "value": "~/Documents/text.txt", "match": "exact" },
      { "app": "filetree", "param": "~/Documents", "property": ["files", "text.txt", "content"], "value": "Goonco", "match": "contains" }
    ]
  },
  {
    "task_id": "prozilla_terminal_01",
    "instruction": "Using terminal, move to the working directory to \"Wallpapers\"",
    "website": "http://localhost:3100",
    "states": [
      { "app": "commands" },
      { "app": "commands", "property": ["currentPath"], "value": "~/Pictures" },
      { "app": "commands", "property": ["currentPath"], "value": "~/Pictures/Wallpapers" }
    ]
  },
  {
    "task_id": "prozilla_terminal_02",
    "instruction": "Using terminal, create a file named goonco.txt under the \"Documents\" directory",
    "website": "http://localhost:3100",
    "states": [
      { "app": "commands" },
      { "app": "commands", "property": ["currentPath"], "value": "~/Documents" },
      { "app": "filetree", "param": "~/Documents", "property": ["files", "goonco.txt", "id"], "value": "goonco.txt", "match": "exact" }
    ]
  },
  {
    "task_id": "prozilla_terminal_03",
    "instruction": "Using terminal, create a README.md under at home directory and write \"# Hello World\" in it.",
    "website": "http://localhost:3100",
    "states": [
