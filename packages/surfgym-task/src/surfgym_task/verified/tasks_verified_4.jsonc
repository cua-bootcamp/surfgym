    {
    "task_id": "web_word_sheet_arxiv_QA_01",
    "instruction": "I want to know about specific facts in 'Attention Is All You Need'. '1. What makes the model to have a diverse perspective?', '2. What method is used to give positional information to the input?'. Write down the answers in Word, and record them in cells A1 and A2 of the spreadsheet.",
    "website": [
      {
        "id": "web",
        "url": "https://arxiv.org/abs/1706.03762"
      },
      {
        "id": "word",
        "url": "http://localhost:3000/word"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "website_id": "word",
          "value": "(?i)multi[\\s-]*head\\s*attention",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i)positional\\s*encoding",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A1",
          "value": "(?i)multi[\\s-]*head\\s*attention",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A2",
          "value": "(?i)positional\\s*encoding",
          "match": "regex"
        }
      ]
    }
  },
  {
    "task_id": "web_word_sheet_arxiv_QA_02",
    "instruction": "I'm studying LoRA's parameter efficiency. Search 'LoRA: Low-Rank Adaptation of Large Language Models' in arxiv page, find: (1) what rank r is used in the main experiments, and (2) how many million trainable parameters LoRA uses when applied to GPT-3 175B. Write both answers in Word. Then in the spreadsheet, put LoRA's trainable parameter count in millions in A1, GPT-3's total parameter count in millions in A2, and compute how many times fewer parameters LoRA trains compared to full fine-tuning in B1 (round to the nearest integer).",
    "website": [
      {"id": "web", "url": "https://arxiv.org"},
      {"id": "word", "url": "http://localhost:3000/word"},
      {"id": "sheet", "url": "http://localhost:3000/spreadsheet"}
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {"website_id": "word", "value": "(?i)r\\s*=?\\s*4|rank.{0,10}4|4.{0,10}rank", "match": "regex"},
        {"website_id": "word", "value": "4\\.7", "match": "contains"},
        {"website_id": "sheet", "mode": "spreadsheet", "cell": "A1", "value": "4.7"},
        {"website_id": "sheet", "mode": "spreadsheet", "cell": "A2", "value": "175000"},
        {"website_id": "sheet", "mode": "spreadsheet", "cell": "B1", "value": "37234"}
      ]
    }
  },

  {
    "task_id": "web_word_sheet_arxiv_QA_03",
    "instruction": "I want to understand CLIP's training scale and zero-shot capability. On its arXiv page, find: (1) how many million image-text pairs CLIP was trained on, and (2) what zero-shot top-1 accuracy it achieves on ImageNet. Write both findings in Word. Then put the training dataset size in millions in A1 and the ImageNet accuracy in A2, and compute how many million training pairs correspond to each percentage point of accuracy in B1 (round to 2 decimal places).",
