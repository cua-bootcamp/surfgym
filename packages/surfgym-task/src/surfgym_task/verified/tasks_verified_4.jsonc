    {
    "task_id": "web_word_sheet_adoptapet_advice_03",
    "instruction": "I am looking for advice on adoptapet.com about whether it is cruel to rehome a dog. In the Word document, document the '3-3-3 rule' mentioned in the article, mapping the duration to its specific outcome in the format '[Duration]: [Outcome]' (e.g., '3 days: start decompressing'). In the spreadsheet, write the header 'Alternatives to Rehoming' in cell A1 and 'Mistakes to Avoid' in cell B1. In cells A2 through A10, list the nine alternative strategies described in the section 'Explore options to address your concerns'. In cells B2 through B6, list the five rehoming mistakes mentioned in 'How not to rehome your dog'. Finally, in cell C2, write a formula to count the total number of alternatives, and in cell D2, write a formula to count the total number of mistakes.",
    "website": [
      {
        "id": "web",
        "url": "https://www.adoptapet.com"
      },
      {
        "id": "word",
        "url": "http://localhost:3000/word"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "website_id": "word",
          "value": "(?i)3\\s*days\\s*:.*start\\s*decompressing",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i)3\\s*weeks\\s*:.*begin\\s*settling\\s*into\\s*(a\\s*)?routine",
