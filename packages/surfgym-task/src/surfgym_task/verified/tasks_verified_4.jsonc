        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A5",
          "value": "(?i)Look\\s*into\\s*dog[- ]walking\\s*services",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A6",
          "value": "(?i)Lean\\s*on\\s*your\\s*support\\s*system",
