        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A1",
          "value": "(?i)Alternatives\\s*to\\s*Rehoming",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "B1",
          "value": "(?i)Mistakes\\s*to\\s*Avoid",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A2",
          "value": "(?i)Take\\s*(your\\s*)?dog\\s*to\\s*the\\s*vet\\s*for\\s*(a\\s*)?checkup",
