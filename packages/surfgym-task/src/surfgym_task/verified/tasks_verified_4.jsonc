        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A3",
          "value": "(?i)Talk\\s*to\\s*(a\\s*)?dog\\s*behaviorist",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "mode": "spreadsheet",
          "cell": "A4",
          "value": "(?i)Hire\\s*(a\\s*)?dog\\s*trainer",
