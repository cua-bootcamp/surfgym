  {
    "task_id": "web_word_sheet_allrecipes_nutrition_03",
    "instruction": "I need to review the detailed nutritional profile for 'Melissa's Chicken Cacciatore' on AllRecipes. Open the full nutrition label and copy all lines from 'Total Carbohydrate' down to 'Potassium', including their, into the Word document. In cells A1 to A3 of the spreadsheet, list the labels 'Total Carbohydrate', 'Protein', and 'Total Fat', and record their numeric values in grams in cells B1 to B3. Finally, in cell C1 of the spreadsheet, calculate the total calories contributed by these three macronutrients using the formula: Carbohydrates * 4 + Protein * 4 + Fat * 9.",
    "website": [
      {
        "id": "web",
        "url": "https://www.allrecipes.com/"
      },
      {
        "id": "word",
        "url": "http://localhost:3000/word"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "website_id": "word",
          "value": "(?i).*Total Carbohydrate\\s*21g.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Dietary Fiber\\s*5g.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Total Sugars\\s*8g.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Protein\\s*29g.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Total Fat\\s*12g.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Saturated Fat\\s*4g.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Cholesterol\\s*63mg.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Vitamin C\\s*26mg.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Sodium\\s*1428mg.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Calcium\\s*362mg.*",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i).*Iron\\s*4mg.*",
          "match": "regex"
        },
        {
