    {
    "task_id": "web_word_sheet_adoptapet_advice_02",
    "instruction": "I am looking for advice on adoptapet.com about behavior and training, specifically how to tame a spicy kitten. In the Word document, record the seven steps and their corresponding goals for building trust in the format '[Step Name]: [Goal]'. In the spreadsheet, write the headers 'Category' in cell A1 and 'Signal Count' in cell B1. Then, list the five body language categories ('Ears', 'Eyes', 'Tail', 'Body posture', and 'Vocalizations') in cells A2 through A6. In cells B2 through B6, record the number of specific signals listed under each category. Finally, in cell B7, use an appropriate spreadsheet function to calculate the total number of signals.",
    "website": [
      {
        "id": "web",
        "url": "https://www.adoptapet.com"
      },
      {
        "id": "word",
        "url": "http://localhost:3000/word"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "website_id": "word",
          "value": "(?i)Settle\\s*&\\s*observe\\s*:.*Emphasize\\s*safety\\s*and\\s*decompression",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i)Build\\s*positive\\s*associations\\s*with\\s*food\\s*:.*Associate\\s*your\\s*presence\\s*with\\s*something\\s*good",
          "match": "regex"
        },
        {
          "website_id": "word",
          "value": "(?i)Introduce\\s*treats\\s*and\\s*gentle\\s*interaction\\s*:.*Pair\\s*your\\s*presence\\s*with\\s*rewards",
          "match": "regex"
