  {
    // BMI reference table: adult categories
    "task_id": "web_sheet_bmi_reference_adult_01",
    "instruction": "I am creating a health education resource for our employees and need to compile the official BMI classification system. Could you please visit the CDC BMI calculator site, find the complete adult BMI categories along with their corresponding BMI ranges, and save this reference information in the spreadsheet starting at A1 with column headers 'BMI Category' and 'BMI Range (kg/m2)'?",
    "website": [
      {
        "id": "web",
        "url": "https://www.cdc.gov/bmi/adult-calculator/index.html"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*BMI\\x*Category.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*BMI\\s*Range.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": "Underweight",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": ".*18\\.5.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A3",
          "value": "Healthy Weight",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B3",
          "value": ".*18\\.5.*25.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A4",
          "value": "Overweight",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B4",
          "value": ".*25.*30.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A5",
          "value": "Obesity",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B5",
          "value": ".*30.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A6",
          "value": "(?i).*Class\\s*1\\s*Obesity.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B6",
          "value": "30.*35",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A7",
          "value": "(?i).*Class\\s*2\\s*Obesity.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B7",
          "value": "35.*40",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A8",
          "value": "(?i).*Class\\s*3\\s*Obesity.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B8",
          "value": ".*40.*",
          "match": "regex"
        }
      ]
    }
  },
