  {
    // BMI reference table: child/teen categories
    "task_id": "web_sheet_bmi_reference_child_01",
    "instruction": "I am creating a pediatric health education resource and need to compile the official BMI classification system for children and teens. Could you please visit the CDC BMI calculator site, find the complete children and teen BMI categories along with their corresponding BMI ranges, and save this reference information in the spreadsheet starting at A1 with column headers 'BMI Category' and 'BMI Range'?",
    "website": [
      {
        "id": "web",
        "url": "https://www.cdc.gov/bmi/child-teen-calculator/index.html"
      },
      {
        "id": "sheet",
        "url": "http://localhost:3000/spreadsheet"
      }
    ],
    "evaluation": {
      "mode": "spreadsheet",
      "operator": "and",
      "rules": [
        {
          "website_id": "sheet",
          "cell": "A1",
          "value": "(?i).*BMI\\s*Category.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B1",
          "value": "(?i).*BMI\\s*Range.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A2",
          "value": "(?i).*Underweight.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B2",
          "value": ".*5.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A3",
          "value": "(?i).*Healthy\\s*Weight.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B3",
          "value": ".*5.*85.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A4",
          "value": "(?i).*Overweight.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B4",
          "value": ".*85.*95.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A5",
          "value": "(?i).*Obesity.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B5",
          "value": ".*95.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "A6",
          "value": "(?i).*Severe\\s*Obesity.*",
          "match": "regex"
        },
        {
          "website_id": "sheet",
          "cell": "B6",
          "value": "(.*120.*95.*|.*35.*)",
          "match": "regex"
        }
      ]
    }
