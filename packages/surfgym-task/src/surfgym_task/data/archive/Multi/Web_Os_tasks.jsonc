      "task_id": "HIPASS-WEB-OS-001",
      "instruction": "I'm planning a business trip to Busan and need to budget for highway expenses. Could you please find the toll fee for a Class 1 vehicle traveling from Seoul Tollgate to Busan Tollgate on the HiPass website (hipass.co.kr), then open text.txt in ProzillaOS and record the result in the format 'Toll Fee: [value]'?",
      "website": [
        {
          "id": "web",
          "url": "https://www.hipass.co.kr/board/TollPaySearchList.do"
        },
        {
          "id": "os",
          "url": "http://localhost:3000/prozilla"
        }
      ],
      "evaluation": {
        "mode": "dom",
        "operator": "and",
        "rules": [
          {
            "website_id": "os",
            "selector": "p[class*='ProzillaOS-WindowTitle']",
            "target": "text",
            "value": "text.txt",
            "match": "contains"
          },
          {
            "website_id": "os",
            "selector": "textarea[class*='_View_']",
            "target": "text",
            "value": "Toll Fee:\\s*[\\d,]+",
