    {
        "task_id": "CDC-WEB-SHEET-001",
        "instruction": "I am helping a colleague track their health metrics and need to calculate BMI information for their wellness profile. Could you please use the CDC BMI calculator to determine the BMI and category for a person (Name: Mike) who is 177 cm tall and weighs 80 kg, then save their name, calculated BMI, and BMI category to the spreadsheet starting at A1 with headers 'Name', 'BMI', and 'BMI Category'?",
        "website": [
            {
                "id": "web",
                "url": "https://www.cdc.gov/bmi/adult-calculator/index.html"
            },
            {
                "id": "sheet",
                "url": "http://localhost:3000/spreadsheet"
            }
        ],
        "evaluation": {
            "mode": "spreadsheet",
            "operator": "and",
            "rules": [
                {"website_id": "sheet", "cell": "A1", "value": "Name", "match": "regex"},
                {"website_id": "sheet", "cell": "B1", "value": "BMI", "match": "regex"},
                {"website_id": "sheet", "cell": "C1", "value": "BMI Category", "match": "regex"},
