                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "ko-fi.com/prozilla",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_07",
        "instruction": "Read 'info.md' inside the Documents folder to find the technologies used to build the website, then save that sentence inside 'text.txt'. Keep the file open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "This website was made using React, Vite and TypeScript.",
                    "match": "contains"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_21",
        "instruction": "Open the App Center, browse apps with the 'Personalization' filter. And change the content of text.txt file to 'Presonalization' filtered app name and save the file. Keep the file open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "(?i)Maths",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_25",
        "instruction": "Check the currently used virtual drive space size (in KB) in Storage. Overwrite '~/Documents/text.txt' with this numeric value and save it. Keep the file open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "^\\d+(\\.\\d+)?$",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_28",
        "instruction": "Filter applications in the App Center by 'Utilities & tools', and note all displayed application names. Write these names joined by a comma and a space into '~/Documents/text.txt' and save the file. Keep the file open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "Notes|Maths|Files|Commands|Browser|Apps",
                    "match": "regex"
                }
            ]
        }
    },
