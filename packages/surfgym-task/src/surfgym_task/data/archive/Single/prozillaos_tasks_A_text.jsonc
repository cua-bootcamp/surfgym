    {
        "task_id": "prozilla_task_A_32",
        "instruction": "Read the developer's business email from 'prozilla.md' and the donation link from 'info.md' inside the Documents folder. Change the content of 'text.txt' to 'email: [email], donate: [donation_link]' format and save the file. Keep the file open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "email: business@prozilla.dev, donate: \\[ko-fi\\.com/prozilla\\]\\(http://ko-fi\\.com/prozilla\\)",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_34",
        "instruction": "In the App Center, filter applications by 'Personalization' and 'Education' categories separately, and count the number of apps displayed in each category. Write a report inside 'text.txt' in the format 'Personalization: [count], Education: [count]' and save the file. Keep the file open.",
        "website": "http://localhost:3000",
        "evaluation": {
            "mode": "dom",
            "operator": "and",
            "rules": [
                {
                    "selector": "p[class*='ProzillaOS-WindowTitle']",
                    "target": "text",
                    "value": "text.txt",
                    "match": "contains"
                },
                {
                    "selector": "textarea[class*='_View_']",
                    "target": "text",
                    "value": "Personalization:\\s*1,\\s*Education:\\s*1",
                    "match": "regex"
                }
            ]
        }
    },
    {
        "task_id": "prozilla_task_A_35",
        "instruction": "Read the developer's name, email, and portfolio address from 'prozilla.md' inside the Documents folder. Change the content of 'text.txt' to organize this information in the format 'Name: [name], Email: [email], Portfolio: [portfolio]' and save the file. Keep the file open.",
