[
   {
      "task_id":"form",
      "instruction":"Use the Social Security Quick Calculator to estimate Alex Kim's retirement benefit. Alex Kim was born on January 1, 1975. Alex's current-year covered earnings are $80,000. Alex plans to retire in January 2042. Select today's dollars, submit the request, and stop when the benefit estimate page is shown.",
      "website":"https://www.ssa.gov/OACT/quickcalc/",
      "evaluation":{
         "operator":"and",
         "rules":[
            {
               "target":"text",
               "value":"Date of birth:\\s*1/1/1975",
               "match":"regex"
            },
            {
               "target":"text",
               "value":"Current earnings:\\s*\\$80,000\\.00",
               "match":"regex"
            },
            {
               "target":"text",
               "value":"Benefit in year-2026 dollars",
               "match":"regex"
            },
            {
               "target":"text",
               "value":"Retirement month:\\s*1/2042",
               "match":"regex"
            }
         ]
      }
   },
