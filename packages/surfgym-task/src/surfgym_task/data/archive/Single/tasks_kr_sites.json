[
  {
    "task_id": "moel_retirement_basic_exact",
    "instruction": "On the MOEL retirement pay calculator, set the join date to 2021-01-01 and the leave date to 2024-01-31, then click 평균임금계산기간보기.",
    "website": "https://labor.moel.go.kr/cmmt/calRtrmnt.do",
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "selector": "#termDays",
          "target": "attr",
          "attr": "value",
          "match": "exact",
          "value": "1125"
        }
      ]
    }
  },
  {
    "task_id": "moel_retirement_full_flow_exact",
    "instruction": "On the MOEL retirement pay calculator, set the join date to 2021-01-01 and the leave date to 2024-01-31, fill the generated wage rows with 기본급 100000, 3000000, 3100000, 3000000, then run 평균임금계산 and 퇴직금계산.",
    "website": "https://labor.moel.go.kr/cmmt/calRtrmnt.do",
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "selector": "#termDays",
          "target": "attr",
          "attr": "value",
          "match": "exact",
          "value": "1125"
        },
        {
          "selector": "#basicSum",
          "target": "attr",
          "attr": "value",
          "match": "regex",
          "value": "^9,?200,?000$"
        },
        {
          "selector": "#dd_pay1",
          "target": "attr",
          "attr": "value",
          "match": "regex",
          "value": "^100,?000(?:\\.0+)?$"
        },
        {
          "selector": "#dd_pay3",
          "target": "attr",
          "attr": "value",
          "match": "regex",
          "value": "^9,?246,?575(?:\\.0+)?$"
        }
      ]
    }
  },
  {
    "task_id": "nhis_open_sick_pay_income_check",
    "instruction": "On the NHIS mock-calculation hub, find the calculator page for checking support related to being unable to work because of an illness or injury that is not work-related, and open it.",
    "website": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do",
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "target": "url",
          "match": "regex",
          "value": "nhis\\.or\\.kr/nhis/policy/retrieveStp2FtbfOslfChkList\\.do"
        }
      ]
    }
  },
  {
    "task_id": "nhis_sick_pay_income_check_consultation_eligible",
    "instruction": "On the NHIS mock-calculation hub, find the calculator for checking support related to being unable to work because of an illness or injury that is not work-related, open it, then check the expected eligibility result for this case: 취업자 자격은 건강보험직장가입자, 가입자 종류는 직장가입자, 가구원 수는 1인, 보험료는 50000.",
    "website": "https://www.nhis.or.kr/nhis/minwon/initCtrbCalcView.do",
    "evaluation": {
      "operator": "and",
      "rules": [
        {
          "selector": "#selWkpcPrsn",
          "target": "attr",
          "attr": "value",
          "match": "exact",
          "value": "1"
        },
        {
          "selector": "#selIsrpKind",
          "target": "attr",
          "attr": "value",
          "match": "exact",
          "value": "1"
        },
        {
          "selector": "#selHhmCnt",
          "target": "attr",
          "attr": "value",
          "match": "exact",
          "value": "1"
        },
        {
          "selector": "#iptWorkAcnImprTermBfmmNhib",
          "target": "attr",
          "attr": "value",
          "match": "regex",
          "value": "^50,?000(?:\\.0+)?$"
        },
        {
          "selector": "#iptTgtYnFcstRslt",
          "target": "attr",
          "attr": "value",
          "match": "exact",
          "value": "상담 대상자"
        }
      ]
    }
  },
