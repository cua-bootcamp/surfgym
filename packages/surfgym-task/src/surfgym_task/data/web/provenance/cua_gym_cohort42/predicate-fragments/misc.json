            "script": "(()=>{const tweets=state.tweets||[];const old=new Set(['p1','p2','p3','p4','p5','p6','p7','p8','p9','p10','p11','p12','p13','p14','p15','p16','p17','p18']);const candidates=tweets.filter(t=>t?.userId==='u1'&&t?.quotedPostId==='p7'&&!old.has(t?.id));if(!candidates.length)return false;const exactText=\"Couldn't agree more. The panel on responsible AI governance was the highlight for me. We need more cross-industry dialogue on this.\";const quote=candidates.find(t=>String(t?.content||'').trim()===exactText)||candidates.at(-1);const content=String(quote?.content||'');if(!content.includes('responsible AI governance')||!content.includes('cross-industry dialogue'))return false;const validPinned=id=>{if(id===quote.id)return true;const t=tweets.find(x=>x?.id===id);return Boolean(t&&t.userId==='u1'&&t.quotedPostId==='p7');};const u1=(state.users||[]).find(u=>u?.id==='u1');return validPinned(u1?.pinnedPostId)&&validPinned(state.currentUser?.pinnedPostId);})()"
