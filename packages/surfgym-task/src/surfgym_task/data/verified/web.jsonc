    "task_id": "web_bmi_01",
    "instruction": "I'd like to find out my BMI using US Customary units. I'm 6 feet 1 inch tall and my weight is 160 pounds.",
    "website": "https://www.cdc.gov/bmi/adult-calculator/index.html",
    "evaluation": {
      "rules": [
        {
