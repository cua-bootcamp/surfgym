    // website revise 404 error
    {
        // BMI record: 5 children, metric units
        "task_id": "web_sheet_bmi_child_record_03",
        "instruction": "I am compiling pediatric health assessments for five children and need their BMI profiles calculated using the CDC children's calculator. Could you please use the children's BMI tool to compute BMI and categories for five children (Names: Alex, Bella, Charlie, Diana, Ethan) with their respective ages and physical measurements (Alex: boy, 5 years 3 months, 113 cm, 19 kg; Bella: girl, 9 years 6 months, 138 cm, 50 kg; Charlie: boy, 4 years 3 months, 104 cm, 17 kg; Diana: girl, 13 years 2 months, 155 cm, 73 kg; Ethan: boy, 11 years, 148 cm, 50 kg), then record all information including names, ages, measurements, calculated BMI values, and BMI categories in the spreadsheet starting at A1 with appropriate headers?",
        "website": [
            {
                "id": "web",
                "url": "https://www.cdc.gov/bmi/child-teen-calculator/index.html"
            },
            {
                "id": "sheet",
                "url": "http://localhost:3000/spreadsheet"
            }
        ],
        "evaluation": {
            "mode": "spreadsheet",
            "operator": "and",
            "rules": [
                {
                    "website_id": "sheet",
                    "cell": "A1",
                    "value": "Name",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A2",
                    "value": "Alex",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A3",
                    "value": "Bella",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A4",
                    "value": "Charlie",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A5",
                    "value": "Diana",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A6",
                    "value": "Ethan",
                    "match": "regex"
                }
            ]
        }
    },
