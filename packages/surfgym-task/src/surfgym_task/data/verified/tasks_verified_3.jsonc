    // Task_A revise evaluation logic, except using text.txt
    {
        // Taskbar pin + auto-launch (multi)
        "task_id": "prozilla_setting_taskbar&app_01",
        "instruction": "Pin 'Wordle' to the taskbar, and enable it to launch automatically upon system startup. Keep the Settings window open.",
        "website": "http://localhost:3100",
        "evaluation": {
            "rules": [
                {
                    "mode": "console",
                    "script": "(() => { const has = [...document.querySelectorAll('.ProzillaOS-Taskbar__AppIcon:not([class*=\"_Hidden\"])')].find(el => el.title === \"Wordle\"); return has?.title ?? \"\"; })();",
                    "value": "Wordle",
                    "match": "exact"
                },
                {
                    "mode": "console",
                    "script": "(() => { const targetLabel = [...document.querySelectorAll(\"span[class*='_Label_']\")].find(span => span.querySelector(\"svg[data-src*='wordle.svg']\") && span.textContent.includes(\"Wordle\")); const container = targetLabel?.closest(\"button\"); const checkbox = container?.querySelector(\"div[class*='_Checkbox_']\"); return checkbox?.className ?? \"\"; })();",
                    "value": "_Checked_oddmx_347",
                    "match": "contains"
                }
            ]
        }
    },
    {
        // App Center filter + auto-launch
        "task_id": "prozilla_appfilter&autolaunch01",
        "instruction": "In the App Center, filter apps by the 'Photo & video' category to find the application. Then enable that app to launch automatically upon system startup. Keep the Settings window open.",
        "website": "http://localhost:3100",
        "evaluation": {
            "rules": [
                {
                    "mode": "console",
                    "script": "(() => { const targetLabel = [...document.querySelectorAll(\"span[class*='_Label_']\")].find(span => span.querySelector(\"svg[data-src*='wordle.svg']\") && span.textContent.includes(\"Photos\")); const container = targetLabel?.closest(\"button\"); const checkbox = container?.querySelector(\"div[class*='_Checkbox_']\"); return checkbox?.className ?? \"\"; })();",
                    "value": "Checked",
                    "match": "exact"
                }
            ]
        }
    },
    {
        // App Center filter + auto-launch
        "task_id": "prozilla_app&auto_launch_01",
        "instruction": "Configure all applications belonging to the 'Utilities & tools' category to launch automatically upon system startup. Keep the Settings window open.",
        "website": "http://localhost:3100",
        "evaluation": {
            "rules": [
                {
                    "mode": "console",
                    "script": "(() => { const targetLabel = [...document.querySelectorAll(\"span[class*='_Label_']\")].find(span => span.querySelector(\"svg[data-src*='app-center.svg']\") && span.textContent.includes(\"Apps\")); const container = targetLabel?.closest(\"button\"); const checkbox = container?.querySelector(\"div[class*='_Checkbox_']\"); return checkbox?.className ?? \"\"; })();",
                    "value": "Checked",
                    "match": "contains"
                },
                {
                    "mode": "console",
                    "script": "(() => { const targetLabel = [...document.querySelectorAll(\"span[class*='_Label_']\")].find(span => span.querySelector(\"svg[data-src*='browser.svg']\") && span.textContent.includes(\"Browser\")); const container = targetLabel?.closest(\"button\"); const checkbox = container?.querySelector(\"div[class*='_Checkbox_']\"); return checkbox?.className ?? \"\"; })();",
                    "value": "Checked",
                    "match": "contains"
                },
                {
                    "mode": "console",
                    "script": "(() => { const targetLabel = [...document.querySelectorAll(\"span[class*='_Label_']\")].find(span => span.querySelector(\"svg[data-src*='terminal.svg']\") && span.textContent.includes(\"Commands\")); const container = targetLabel?.closest(\"button\"); const checkbox = container?.querySelector(\"div[class*='_Checkbox_']\"); return checkbox?.className ?? \"\"; })();",
                    "value": "Checked",
