    {
        // File edit
        "task_id": "prozilla_file_edit_02",
        "instruction": "Open 'fizzbuzz.sh' inside the 'Scripts' folder using the Text Editor, modify the default iteration range (COUNT) from its original value to 50, and save the file. Keep the file open after saving.",
        "website": "http://localhost:3100",
        "evaluation": {
            "rules": [
                {
                    "mode": "console",
                    "script": "[...document.querySelectorAll(\"div[class*='Window-container']:not([class*='Minimized']) p[class*='ProzillaOS-WindowTitle']\")].map(el => el.textContent).join(' ')",
                    "value": "fizzbuzz.sh",
                    "match": "contains"
                },
                {
                    "mode": "console",
                    "script": "document.querySelector(\"[class*='_View_']\")?.value || document.querySelector(\"[class*='_View_']\")?.textContent || \"\"",
                    "value": "COUNT=${1:-50}",
                    "match": "contains"
                }
            ]
        }
    },
    {
        // Compare folder sizes + delete larger
        "task_id": "prozilla_file_delete_folder_01",
        "instruction": "Open the Files application, compare the total file sizes inside the 'Videos' and 'Audio' folders. Delete the folder that has the larger total file size, and then navigate back to the home directory in the Files application.",
        "website": "http://localhost:3100",
        "evaluation": {
            "rules": [
                {
                    "mode": "console",
                    "script": "document.querySelector(\"input[class*='PathInput']\")?.value ?? \"\"",
                    "value": "~",
                    "match": "exact"
                },
                {
                    "mode": "console",
                    "script": "document.querySelector(\"[class*='DirectoryList']\")?.textContent ?? \"\"",
                    "value": "(?s)^(?!.*Audio)",
                    "match": "regex"
                }
            ]
        }
    },
