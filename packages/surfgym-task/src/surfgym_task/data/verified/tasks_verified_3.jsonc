    {
        "task_id": "web_sheet_arxiv_submit_date_01",
        "instruction": "I need the submission dates for two arXiv papers — 'OSWorld: Benchmarking Multimodal Agents for Open-Ended Tasks in Real Computer Environments' and 'UI-TARS-2 Technical Report: Advancing GUI Agent with Multi-Turn Reinforcement Learning'. Could you record each paper's title and submission date in a sheet with columns Article and Submitted Date starting from A1?",
        "website": [
            {
                "id": "web",
                "url": "https://arxiv.org/"
            },
            {
                "id": "sheet",
                "url": "http://localhost:3000/spreadsheet"
            }
        ],
        "evaluation": {
            "mode": "spreadsheet",
            "operator": "and",
            "rules": [
                {
                    "website_id": "sheet",
                    "cell": "A1",
                    "value": "(?i).*Article.*",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "B1",
                    "value": "(?i).*Submitted\\s*Date.*",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A2",
                    "value": "(?i).*OSWorld: Benchmarking Multimodal Agents for Open-Ended Tasks in Real Computer Environments.*",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "B2",
                    "value": "(?i).*30.*May.*2024.*",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "A3",
                    "value": "(?i).*UI-TARS-2 Technical Report: Advancing GUI Agent with Multi-Turn Reinforcement Learning.*",
                    "match": "regex"
                },
                {
                    "website_id": "sheet",
                    "cell": "B3",
                    "value": "(?i).*5.*September.*2025.*",
                    "match": "regex"
                }
            ]
        }
    },
