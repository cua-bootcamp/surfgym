{
  "task_id": "car_electric_fuel",
  "hash": "car_electric_fuel",
  "instruction": "Find electric rental cars in Madrid with a daily price of EUR 100 or less.",
  "website": {
    "base": "http://localhost:3200/cars/search",
    "param": {
      "pickup": "Madrid"
    }
  },
  "complexity": 3,
  "evaluation": {
    "operator": "and",
    "criteria": [
      {
        "script": "(()=>{const h=[...document.querySelectorAll('h3')].find(x=>x.textContent.trim()==='Fuel type');if(!h)return false;const l=[...h.parentElement.querySelectorAll('label')].find(x=>x.textContent.trim().startsWith('Electric'));return l?l.querySelector('input[type=checkbox]').checked:false;})()",
        "value": true,
        "match": "exact"
      },
      {
        "target": "attr",
        "selector": "input[type=range]",
        "attr": "value",
        "match": "regex",
        "value": "^([0-9]|[1-9][0-9]|100)$"
      }
    ]
  }
}