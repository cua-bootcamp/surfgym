{
  "task_id": "flight_route_date_tomorrow",
  "hash": "flight_route_date_tomorrow",
  "instruction": "Find flights from London Heathrow to Paris Charles de Gaulle departing tomorrow.",
  "website": {
    "base": "http://localhost:3200/flights"
  },
  "complexity": 4,
  "evaluation": {
    "operator": "and",
    "criteria": [
      {
        "target": "url",
        "match": "contains",
        "value": "originCode=LHR"
      },
      {
        "target": "url",
        "match": "contains",
        "value": "destCode=CDG"
      },
      {
        "script": "(()=>{const p=new URL(location.href).searchParams.get('depart');const d=new Date();d.setDate(d.getDate()+1);const t=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');return p===t;})()",
        "value": true,
        "match": "exact"
      }
    ]
  }
}