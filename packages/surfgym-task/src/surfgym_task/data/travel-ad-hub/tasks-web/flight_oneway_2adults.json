{
  "task_id": "flight_oneway_2adults",
  "hash": "flight_oneway_2adults",
  "instruction": "Search for a one-way flight from Amsterdam to Rome for 2 adults on the 20th of next month.",
  "website": {
    "base": "http://localhost:3200/flights"
  },
  "complexity": 6,
  "evaluation": {
    "operator": "and",
    "criteria": [
      {
        "target": "url",
        "match": "contains",
        "value": "originCode=AMS"
      },
      {
        "target": "url",
        "match": "contains",
        "value": "destCode=FCO"
      },
      {
        "target": "url",
        "match": "contains",
        "value": "tripType=one-way"
      },
      {
        "target": "url",
        "match": "contains",
        "value": "adults=2"
      },
      {
        "script": "(()=>{const p=new URL(location.href).searchParams.get('depart');const n=new Date();const d=new Date(n.getFullYear(),n.getMonth()+1,20);const t=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');return p===t;})()",
        "value": true,
        "match": "exact"
      }
    ]
  }
}