{
  "instruction": "Convert the existing status grid note into a 3-row, 2-column table and fill the cells with the listed labels and values.",
  "empty_start": false,
  "states": [
    [
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-body",
        "property": ["text"],
        "value": "Status grid: Owner Mina, Stage Review, Flag Active"
      }
    ],
    [
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-table",
        "property": ["tables", "0", "shape"],
        "value": "3x2"
      },
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-table",
        "property": ["tables", "0", "cellsText"],
        "value": "Owner|Mina|Stage|Review|Flag|Active"
      }
    ]
  ]
}
