{
  "instruction": "Split the existing page note into two paragraphs and add the footer text \"Page split prepared\".",
  "empty_start": false,
  "states": [
    [
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-body",
        "property": [
          "text"
        ],
        "value": "Page one text / Page two text"
      }
    ],
    [
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-body",
        "property": [
          "text"
        ],
        "value": "Page one text\nPage two text"
      }
    ],
    [
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-paragraph",
        "property": [
          "paragraphs",
          "0",
          "horizontalAlign"
        ],
        "value": "justify"
      },
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-paragraph",
        "property": [
          "paragraphs",
          "1",
          "horizontalAlign"
        ],
        "value": "right"
      },
      {
        "match": "exact",
        "applyf": "applyWordMeta",
        "evalf": "getWordMeta",
        "param": "word-footer",
        "property": [
          "text"
        ],
        "value": "Page split prepared"
      }
    ]
  ]
}
