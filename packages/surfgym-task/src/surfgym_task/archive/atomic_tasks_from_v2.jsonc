          "match": "contains"
        }
      ]
    }
  },

  {
    // 출처: prozilla_file_delete_01 step 4-5 "ProzillaOS.png 오른쪽 클릭 → delete"
    "task_id": "atom_p_files_delete_prozillaos_png",
    "description": "~/Pictures 에서 ProzillaOS.png 삭제",
    "state_pre": "files_at_pictures",
    "state_post": "prozillaos_png_deleted",
    "instruction": "In the Files application (at ~/Pictures), delete the file 'ProzillaOS.png'.",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); await page.fill(\"input[class*='PathInput']\", '~/Pictures'); await page.keyboard.press('Enter'); await page.waitForTimeout(600);"
    },
    "step_playwright": "await page.click('button.ProzillaOS-DirectoryList__File:has-text(\"ProzillaOS.png\")', { button: 'right' }); await page.waitForTimeout(200); await page.click('text=\"Delete\"'); await page.waitForTimeout(400);",
    "evaluation": {
      "rules": [
