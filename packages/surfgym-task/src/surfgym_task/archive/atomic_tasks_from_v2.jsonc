  {
    // 출처: prozilla_file_delete_folder_01 "Audio 폴더와 크기 비교"
    "task_id": "atom_p_files_nav_audio",
    "description": "Files 앱에서 ~/Audio 폴더로 이동",
    "state_pre": "files_open",
    "state_post": "files_at_audio",
    "instruction": "In the Files application, navigate to the 'Audio' folder.",
