  // ═══════════════════════════════════════════════════════════════════
  // SECTION 12: 파일 편집 (Notes 앱 내 텍스트 편집)
  // ═══════════════════════════════════════════════════════════════════
  // 출처: prozilla_file_edit_01, prozilla_file_edit_02
  // Notes textarea: textarea[class*="_View_"]

  {
    // 출처: prozilla_file_edit_02 step 4-5 "COUNT 값 27→50으로 변경"
    "task_id": "atom_p_notes_edit_fizzbuzz_count_50",
    "description": "fizzbuzz.sh 에서 COUNT 기본값을 27에서 50으로 변경",
    "state_pre": "fizzbuzz_open_in_notes",
    "state_post": "fizzbuzz_count_changed_to_50",
    "instruction": "In the Notes application with 'fizzbuzz.sh' open, change the default iteration count from 27 to 50 (find 'COUNT=${1:-27}' and change '27' to '50').",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); await page.fill(\"input[class*='PathInput']\", '~/Scripts'); await page.keyboard.press('Enter'); await page.waitForTimeout(600); await page.dblclick('button.ProzillaOS-DirectoryList__File:has-text(\"fizzbuzz.sh\")'); await page.waitForTimeout(600);"
    },
    "step_playwright": "const ta = await page.$('textarea[class*=\"_View_\"]'); const val = await ta.inputValue(); await ta.fill(val.replace('COUNT=${1:-27}', 'COUNT=${1:-50}')); await page.waitForTimeout(200);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "document.querySelector(\"textarea[class*='_View_']\")?.value ?? ''",
          "value": "COUNT=${1:-50}",
          "match": "contains"
        }
      ]
    }
  },

  {
    // 출처: prozilla_file_edit_01 "i%7==0일 때 Buzz 출력 조건 추가"
    "task_id": "atom_p_notes_edit_fizzbuzz_add_buzz7",
    "description": "fizzbuzz.sh 에서 i가 7의 배수일 때 Buzz를 출력하는 조건 추가",
    "state_pre": "fizzbuzz_open_in_notes",
    "state_post": "fizzbuzz_buzz7_added",
    "instruction": "In the Notes application with 'fizzbuzz.sh' open, add a condition so that 'Buzz' is output when 'i' is divisible by 7 (i % 7 == 0).",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); await page.fill(\"input[class*='PathInput']\", '~/Scripts'); await page.keyboard.press('Enter'); await page.waitForTimeout(600); await page.dblclick('button.ProzillaOS-DirectoryList__File:has-text(\"fizzbuzz.sh\")'); await page.waitForTimeout(600);"
    },
    "step_playwright": "const ta = await page.$('textarea[class*=\"_View_\"]'); const val = await ta.inputValue(); await ta.fill(val.replace('i % 5 == 0', 'i % 7 == 0')); await page.waitForTimeout(200);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "document.querySelector(\"textarea[class*='_View_']\")?.value ?? ''",
          "value": "i % 7 == 0",
          "match": "contains"
        },
        {
          "mode": "console",
          "script": "document.querySelector(\"textarea[class*='_View_']\")?.value ?? ''",
          "value": "OUTPUT+=\"Buzz\"",
          "match": "contains"
        }
      ]
    }
  },

  {
    // 출처: prozilla_file_edit_02 step 6-7 "File 탭 클릭 → Save 클릭 (또는 Ctrl+S)"
    "task_id": "atom_p_notes_save_file",
    "description": "Notes 앱에서 현재 파일 저장 (Ctrl+S)",
    "state_pre": "fizzbuzz_open_in_notes",
    "state_post": "fizzbuzz_saved",
    "instruction": "In the Notes application with a file open, save the file using Ctrl+S.",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); await page.fill(\"input[class*='PathInput']\", '~/Scripts'); await page.keyboard.press('Enter'); await page.waitForTimeout(600); await page.dblclick('button.ProzillaOS-DirectoryList__File:has-text(\"fizzbuzz.sh\")'); await page.waitForTimeout(600);"
    },
    "step_playwright": "await page.keyboard.press('Control+s'); await page.waitForTimeout(300);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const title = [...document.querySelectorAll(\"p[class*='ProzillaOS-WindowTitle']\")].find(el => el.textContent.includes('fizzbuzz.sh')); return title?.textContent.includes('(preview)') ? 'preview' : 'saved'; })()",
          "value": "saved",
          "match": "exact"
        }
      ]
    }
  },

  // ═══════════════════════════════════════════════════════════════════
  // [조합 테스트 섹션]
  // ═══════════════════════════════════════════════════════════════════

  {
    // 목적: atom_p_open_files + atom_p_files_nav_videos + atom_p_files_open_weezer_properties 의 조합 시연
    "task_id": "task_combined_test_files_and_properties",
    "description": "[조합 테스트] 바탕화면에서 출발하여 Files 실행, Videos 이동, Weezer.yt 속성 창 조회까지 연속 수행",
    "state_pre": "desktop",
    "state_post": "weezer_properties_open",
    "instruction": "Open the Files application, navigate to '~/Videos', right-click on 'Weezer_Buddy-Holly.yt', and open its 'Properties'.",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "" // 바탕화면에서 온전히 조작을 개시하므로 빈 문자열
    },
    "step_playwright": "/* 1. Files 앱 열기 */ await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); /* 2. ~/Videos 로 이동 */ await page.fill(\"input[class*='PathInput']\", '~/Videos'); await page.keyboard.press('Enter'); await page.waitForTimeout(600); /* 3. Weezer_Buddy-Holly.yt 속성 조회 */ await page.click('button.ProzillaOS-DirectoryList__File:has-text(\"Weezer_Buddy-Holly.yt\")', { button: 'right' }); await page.waitForTimeout(200); await page.click('text=\"Properties\"'); await page.waitForTimeout(400);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const t = [...document.querySelectorAll('p')].find(el => el.textContent.includes('Properties')); return t?.textContent.trim() ?? ''; })()",
          "value": "Properties",
          "match": "contains"
        }
      ]
    }
  }
]
