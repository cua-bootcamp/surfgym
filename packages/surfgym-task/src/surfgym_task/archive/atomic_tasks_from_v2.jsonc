    },
    "step_playwright": "await page.fill(\"input[class*='PathInput']\", '~/Videos'); await page.keyboard.press('Enter'); await page.waitForTimeout(600);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "document.querySelector(\"input[class*='PathInput']\")?.value ?? ''",
          "value": "~/Videos",
          "match": "exact"
