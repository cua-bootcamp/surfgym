  // ── Files 서브폴더 진입 ───────────────────────────────────────────

  {
    // 출처: prozilla_file_find_02 step 3 "Wallpapers 폴더 열기"
    "task_id": "atom_p_files_enter_wallpapers",
    "description": "~/Pictures에서 Wallpapers 폴더 열기",
    "state_pre": "files_at_pictures",
    "state_post": "files_at_wallpapers",
    "instruction": "In the Files application (at ~/Pictures), open the 'Wallpapers' folder.",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); await page.fill(\"input[class*='PathInput']\", '~/Pictures'); await page.keyboard.press('Enter'); await page.waitForTimeout(600);"
    },
    "step_playwright": "await page.dblclick('button.ProzillaOS-DirectoryList__File:has-text(\"Wallpapers\")'); await page.waitForTimeout(600);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "document.querySelector(\"input[class*='PathInput']\")?.value ?? ''",
          "value": "~/Pictures/Wallpapers",
          "match": "exact"
        }
      ]
    }
  },

