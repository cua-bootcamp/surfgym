      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Settings'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForTimeout(600); await page.click('[role=\"tab\"]:has-text(\"Appearance\")'); await page.waitForTimeout(300); await page.click('[class*=\"NavButton\"]:has-text(\"Theme\")'); await page.waitForTimeout(300);"
