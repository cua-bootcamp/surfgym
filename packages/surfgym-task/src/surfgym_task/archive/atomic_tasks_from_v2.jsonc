    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const root = document.documentElement; const hasOther = ['Mango-theme','Aqua-theme','Grape-theme','Light-theme','Cherry-theme'].some(c => root.classList.contains(c) || document.querySelector('.' + c)); return hasOther ? 'other' : 'dark'; })()",
          "value": "dark",
          "match": "exact"
        }
      ]
    }
  },

