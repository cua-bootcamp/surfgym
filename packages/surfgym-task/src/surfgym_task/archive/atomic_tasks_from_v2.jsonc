// ProzillaOS 전체 atomic 태스크 목록
//
// 목적: 모든 ProzillaOS 태스크를 단일 UI 액션 단위로 분해.
//       조합 방법: setup.playwright + step_playwright 를 연결해 새 태스크의 사전 상태 구성.
//
// 각 항목 구조:
//   task_id         : 고유 식별자
//   description     : 이 단계가 하는 일 (한국어)
//   state_pre       : 이 액션 전의 상태 레이블
//   state_post      : 이 액션 후의 상태 레이블 (정답 상태)
//   instruction     : RL 에이전트에게 주는 영문 지시
//   website         : 대상 URL
//   setup.playwright: 사전 상태에 도달하기 위한 Playwright 스크립트
//   step_playwright : 이 액션 자체의 Playwright (정답 액션)
//   evaluation      : 이 액션의 결과를 검증하는 규칙
//
// 출처: tasks_verified_2_atomic.jsonc 의 단계별 한국어 주석
//
// 조합 예시:
//   새 태스크 setup = atomA.step_playwright + atomB.step_playwright + atomC.step_playwright
//   에이전트 액션  = atomD.instruction+
//   평가           = atomD.evaluation
[

  // ═══════════════════════════════════════════════════════════════════
  // SECTION 1: 앱 실행 (사전 상태 없음, 기본 데스크톱)
  // ═══════════════════════════════════════════════════════════════════

  {
    // ────────────────────────────────────────────────────────────────
    // 출처: 모든 file 관련 태스크 step 1 "Files 열기"
    "task_id": "atom_p_open_files",
    "description": "Files 앱 열기",
    "state_pre": "desktop",
    "state_post": "files_open",
    "instruction": "Open the Files application.",
    "website": "http://localhost:3100",
    "setup": { "playwright": "" },
    "step_playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\");",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const t = [...document.querySelectorAll(\"p[class*='ProzillaOS-WindowTitle']\")].find(el => el.textContent.trim() === 'Files'); return t?.innerText ?? ''; })()",
          "value": "Files",
          "match": "exact"
        }
      ]
    }
  },

  {
    // 출처: 모든 setting 관련 태스크 step 1 "Settings 열기"
    "task_id": "atom_p_open_settings",
    "description": "Settings 앱 열기",
    "state_pre": "desktop",
    "state_post": "settings_open",
    "instruction": "Open the Settings application.",
    "website": "http://localhost:3100",
    "setup": { "playwright": "" },
    "step_playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Settings'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForTimeout(600);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const t = [...document.querySelectorAll(\"p[class*='ProzillaOS-WindowTitle']\")].find(el => el.textContent.trim() === 'Settings'); return t?.innerText ?? ''; })()",
          "value": "Settings",
          "match": "exact"
        }
      ]
    }
  },

  {
    // 출처: prozilla_appfilter_01 step 1 "OS 아이콘 → Apps 클릭"
    "task_id": "atom_p_open_appcenter",
    "description": "App Center(Apps) 앱 열기",
    "state_pre": "desktop",
    "state_post": "appcenter_open",
    "instruction": "Open the App Center (Apps) application.",
    "website": "http://localhost:3100",
    "setup": { "playwright": "" },
    "step_playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Apps'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForTimeout(600);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const t = [...document.querySelectorAll(\"p[class*='ProzillaOS-WindowTitle']\")].find(el => el.textContent.trim() === 'Apps'); return t?.innerText ?? ''; })()",
          "value": "Apps",
          "match": "exact"
        }
      ]
    }
  },

  {
    // 출처: prozilla_search_01 "검색창 열기 → Bliss Radio 입력 → Enter"
    "task_id": "atom_p_search_open_bliss_radio",
    "description": "검색창에서 Bliss Radio 앱 검색하여 열기",
    "state_pre": "desktop",
    "state_post": "bliss_radio_open",
    "instruction": "Search for and open the 'Bliss Radio' application.",
    "website": "http://localhost:3100",
    "setup": { "playwright": "" },
    "step_playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Bliss Radio'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForTimeout(600);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "(() => { const t = [...document.querySelectorAll(\"p[class*='ProzillaOS-WindowTitle']\")].find(el => el.textContent.trim() === 'Bliss Radio'); return t?.innerText ?? ''; })()",
          "value": "Bliss Radio",
          "match": "exact"
        }
      ]
    }
  },

  // ═══════════════════════════════════════════════════════════════════
  // SECTION 2: Files 폴더 네비게이션
  // ═══════════════════════════════════════════════════════════════════

  {
    // 출처: prozilla_file_find_01 step 2 ".config 폴더 열기"
    "task_id": "atom_p_files_nav_config",
    "description": "Files 앱에서 ~/.config 폴더로 이동",
    "state_pre": "files_open",
    "state_post": "files_at_config",
    "instruction": "In the Files application, navigate to the '.config' folder.",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\");"
    },
    "step_playwright": "await page.fill(\"input[class*='PathInput']\", '~/.config'); await page.keyboard.press('Enter'); await page.waitForTimeout(600);",
    "evaluation": {
      "rules": [
        {
          "mode": "console",
          "script": "document.querySelector(\"input[class*='PathInput']\")?.value ?? ''",
          "value": "~/.config",
          "match": "exact"
        }
      ]
    }
  },

  {
    // 출처: prozilla_file_find_02 step 2 "Pictures 폴더 열기"
    "task_id": "atom_p_files_nav_pictures",
    "description": "Files 앱에서 ~/Pictures 폴더로 이동",
