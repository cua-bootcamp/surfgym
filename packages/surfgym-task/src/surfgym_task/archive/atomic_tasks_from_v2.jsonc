  {
    // 출처: prozilla_file_delete_folder_01 마지막 "홈 디렉터리로 돌아가기"
    // setup에서 ~/Videos로 이동시켜 '홈으로 이동'이 의미있는 액션이 되도록 함
    "task_id": "atom_p_files_nav_home",
    "description": "Files 앱에서 ~ (홈) 경로로 이동 (~/Videos에서 출발)",
    "state_pre": "files_at_videos",
    "state_post": "files_at_home",
    "instruction": "In the Files application (currently in a subfolder), navigate to the home directory (~).",
    "website": "http://localhost:3100",
    "setup": {
      "playwright": "await page.click('button[title=\"Search\"]'); await page.waitForTimeout(200); await page.fill('input[aria-label=\"Search query\"]', 'Files'); await page.waitForTimeout(200); await page.keyboard.press('Enter'); await page.waitForSelector(\"input[class*='PathInput']\"); await page.fill(\"input[class*='PathInput']\", '~/Videos'); await page.keyboard.press('Enter'); await page.waitForTimeout(400);"
    },
    "step_playwright": "await page.fill(\"input[class*='PathInput']\", '~'); await page.keyboard.press('Enter'); await page.waitForTimeout(600);",
    "evaluation": {
