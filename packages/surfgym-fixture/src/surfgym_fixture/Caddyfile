:{$MAIN_PORT:3000} {
	root * ./dist
	encode zstd gzip

	header Cache-Control "no-store"

	try_files {path} {path}/index.html =404

	file_server {
		precompressed zstd gzip
	}
}

:{$PROZILLA_PORT:3100} {
	root * ./prozilla-os/demo/dist
	encode zstd gzip

	header Cache-Control "no-store"

	try_files {path} {path}/index.html =404

	file_server {
		precompressed zstd gzip
	}
}
